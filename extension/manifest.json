
{
  "manifest_version": 3,
  "name": "Aamen - آمن",
  "version": "1.1.0",
  "description": "Aamen: AI-assisted Terms and Conditions analysis with Saudi PDPL screening and personal privacy preferences.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
