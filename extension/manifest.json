
{
  "manifest_version": 3,
  "name": "Aamen - آمن",
  "version": "1.0.0",
  "description": "User-initiated T&C privacy screening with a Python backend.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
