{
  "manifest_version": 3,
  "name": "Aamen WP10 - آمن",
  "version": "1.2.0",
  "description": "Ask Aamen about analyzed terms and import PDF terms alongside existing privacy and PDPL checks.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/aamen-16.png",
      "32": "assets/aamen-32.png",
      "48": "assets/aamen-48.png",
      "128": "assets/aamen-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/aamen-16.png",
    "32": "assets/aamen-32.png",
    "48": "assets/aamen-48.png",
    "128": "assets/aamen-128.png"
  }
}
